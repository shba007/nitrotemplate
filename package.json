{
  "name": "nitrotemplate",
  "version": "0.0.2",
  "description": "Nitro + Typescript Template",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shba007/nitrotemplate.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.11.0 || ^24.14.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^11.0.0",
    "bun": "^1.2.9"
  },
  "packageManager": "bun@1.4.0",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "nitro prepare",
    "dev": "nitro dev",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test:load": "k6 run tests/load.test.ts",
    "build": "nitro build",
    "generate": "nitro generate",
    "preview": "nitro preview",
    "start": "node --env-file=.env.prod .output/server/index.mjs",
    "clean": "nitro cleanup",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t nitrotemplate:dev .",
    "docker:start": "docker run --detach --name nitrotemplate-dev --env-file .env.prod -p 3500:3000 nitrotemplate:dev"
  },
  "dependencies": {
    "nitro": "^3.0.260610-beta",
    "nitro-mcp-toolkit": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@dotenvx/dotenvx": "^2.21.0",
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.1",
    "eslint-config-unjs": "^0.6.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
